#===============================================================================================================
# WHIRLING GLACIAL BOLT — Mercenary · Gemling Legionnaire (guia: grimorio-de-builds / whirling)
# Camada da build: destaca o que a build usa e esconde armas normais/mágicas que ela nunca usa.
# Cores: azul-gelo = peça da build. Para desligar o esconde-armas, apague o bloco 'Hide' no fim desta camada.
#===============================================================================================================

# --- Uniques da build (o filtro enxerga só a base; confira o nome: Tense Crossbow = Rampart Raptor, Winged Spear = Skysliver, Garment = Tabula Rasa, Iron Ring = Blackheart, Rawhide Belt = Meginord's Girdle, Wrapped Sandals = Wanderlust, Spired Greathelm = Thrillsteel, Grand Regalia = Morior Invictus)
Show # build: uniques
	Rarity Unique
	BaseType == "Tense Crossbow" "Winged Spear" "Garment" "Iron Ring" "Rawhide Belt" "Wrapped Sandals" "Spired Greathelm" "Grand Regalia"
	SetFontSize 45
	SetTextColor 111 214 255 255
	SetBorderColor 111 214 255 255
	SetBackgroundColor 8 34 62 255
	PlayAlertSound 2 300
	PlayEffect Cyan
	MinimapIcon 0 Cyan Star

# --- Spear branca: a Whirling Slash precisa de uma spear no Weapon Set 1 desde o nível 1
Show # build: spear branca do começo
	AreaLevel <= 20
	Class == "Spears"
	Rarity Normal
	SetFontSize 40
	SetTextColor 111 214 255 255
	SetBorderColor 111 214 255 255
	PlayAlertSound 2 200
	PlayEffect Cyan Temp
	MinimapIcon 1 Cyan Diamond

# --- Gems que viram peça da build (o nível do Uncut é o tier da skill)
Show # build: Uncut Skill Gem nível 7 — Glacial Bolt: a skill principal do nível 24 ao 100
	GemLevel 7
	BaseType "Uncut Skill Gem"
	SetFontSize 44
	SetTextColor 111 214 255 255
	SetBorderColor 111 214 255 255
	SetBackgroundColor 8 34 62 255
	PlayAlertSound 2 300
	PlayEffect Cyan
	MinimapIcon 0 Cyan Triangle

